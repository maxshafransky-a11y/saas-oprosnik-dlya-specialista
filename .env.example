# Только локальная разработка. Не использовать эти credentials вне dev.
APP_ENV=development
# Local fallback only; staging/production must set a random value with at least 32 characters.
APP_SECRET_KEY=dev-only-app-secret-key-not-for-production-change-me

POSTGRES_DB=health_intake
POSTGRES_USER=health_owner
POSTGRES_PASSWORD=health_owner_dev_only

# SQLAlchemy URL для restricted health_app runtime.
DATABASE_URL=postgresql+psycopg://health_app:health_app_dev_only@127.0.0.1:55432/health_intake
# SQLAlchemy URL для health_owner migrations.
DATABASE_OWNER_URL=postgresql+psycopg://health_owner:health_owner_dev_only@127.0.0.1:55432/health_intake

# Public origin used in passwordless magic links.
PUBLIC_BASE_URL=http://localhost:8000

# SMTP relay for magic link + OTP email. Leave empty until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Private S3-compatible storage for medical files. Set real credentials outside dev.
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Scan worker: run one worker per workspace to preserve RLS tenant isolation.
SCAN_WORKSPACE_ID=
SCAN_POLL_SECONDS=5
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=60
